<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>中国近现代史纲要</title>
<link rel="icon" type="image/png" sizes="32x32" href="/icon-32x32.png">
<style>
  :root {
    --bg: #0b0f14;
    --panel: #111827;
    --panel2: #0f172a;
    --text: #e5e7eb;
    --muted: #9ca3af;
    --border: rgba(255,255,255,.10);
    --ok: #10b981;
    --bad: #ef4444;
    --warn: #f59e0b;
    --link: #60a5fa;
    --shadow: 0 10px 30px rgba(0,0,0,.35);
    --radius: 14px;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: linear-gradient(180deg, #0b0f14 0%, #090d12 100%);
    color: var(--text);
    font-family: system-ui, -apple-system, Segoe UI, Roboto, "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", Arial, sans-serif;
    line-height: 1.45;
  }
  a { color: var(--link); }
  .wrap {
    max-width: 980px;
    margin: 0 auto;
    padding: 20px 16px 96px;
  }
  header {
    position: sticky;
    top: 0;
    z-index: 5;
    backdrop-filter: blur(10px);
    background: rgba(11,15,20,.7);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 14px 16px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  h1 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: .2px;
  }
  .sub {
    color: var(--muted);
    font-size: 12px;
  }
  .controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .ctrl {
    background: rgba(17,24,39,.75);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 10px;
    box-shadow: var(--shadow);
  }
  .ctrl-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
  }
  .stats {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    color: var(--muted);
    font-size: 12px;
  }
  .pill {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 10px;
    background: rgba(15,23,42,.6);
  }
  .pill strong { color: var(--text); font-weight: 700; }
  .btn {
    appearance: none;
    border: 1px solid var(--border);
    background: rgba(15,23,42,.8);
    color: var(--text);
    border-radius: 12px;
    padding: 10px 12px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    transition: transform .04s ease, border-color .12s ease;
  }
  .btn:hover { border-color: rgba(255,255,255,.22); }
  .btn:active { transform: translateY(1px); }
  .btn.primary {
    background: rgba(59,130,246,.25);
    border-color: rgba(59,130,246,.5);
  }
  .btn.danger {
    background: rgba(239,68,68,.18);
    border-color: rgba(239,68,68,.45);
  }
  .btn.ghost {
    background: rgba(17,24,39,.45);
  }
  .input {
    width: 100%;
    background: rgba(15,23,42,.7);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 10px 12px;
    color: var(--text);
    font-size: 13px;
    outline: none;
  }
  .input:focus { border-color: rgba(96,165,250,.65); }
  .section {
    margin-top: 18px;
  }
  .section h2 {
    margin: 18px 0 10px;
    font-size: 15px;
    color: #f3f4f6;
  }
  .q {
    background: rgba(17,24,39,.70);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px;
    margin: 10px 0;
    box-shadow: var(--shadow);
  }
  .q.correct { border-color: rgba(16,185,129,.55); }
  .q.wrong { border-color: rgba(239,68,68,.55); }
  .q.unanswered { border-color: rgba(245,158,11,.55); }
  .q-head {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    justify-content: space-between;
  }
  .q-title {
    font-weight: 700;
    font-size: 13px;
  }
  .q-meta {
    color: var(--muted);
    font-size: 12px;
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .tag {
    border: 1px solid var(--border);
    background: rgba(15,23,42,.55);
    padding: 3px 8px;
    border-radius: 999px;
    font-size: 12px;
  }
  .tag.ok { border-color: rgba(16,185,129,.55); color: #a7f3d0; }
  .tag.bad { border-color: rgba(239,68,68,.55); color: #fecaca; }
  .tag.warn { border-color: rgba(245,158,11,.55); color: #fde68a; }
  .stem {
    margin-top: 8px;
    white-space: pre-wrap;
    word-break: break-word;
    font-size: 13px;
  }
  .options {
    margin-top: 10px;
    display: grid;
    gap: 8px;
  }
  .opt {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 10px 10px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: rgba(15,23,42,.55);
    cursor: pointer;
    user-select: none;
  }
  .opt:hover { border-color: rgba(255,255,255,.22); }
  .opt input { margin-top: 2px; }
  .opt .letter {
    width: 20px;
    font-weight: 800;
    color: #c7d2fe;
  }
  .opt .text {
    flex: 1;
    white-space: pre-wrap;
    word-break: break-word;
    font-size: 13px;
    color: #e5e7eb;
  }
  .opt.correct {
    border-color: rgba(16,185,129,.65);
    background: rgba(16,185,129,.10);
  }
  .opt.wrong {
    border-color: rgba(239,68,68,.65);
    background: rgba(239,68,68,.10);
  }
  .answer-line {
    margin-top: 10px;
    font-size: 12px;
    color: var(--muted);
    display: none;
  }
  .answer-line.show { display: block; }
  .answer-line b { color: #f3f4f6; }
  
  .stem.code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 13px;
  }
  .blank-input {
    display: inline-block;
    min-width: 150px;
    max-width: 100%;
    padding: 6px 8px;
    margin: 2px 2px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: rgba(255,255,255,.04);
    color: var(--fg);
    outline: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 13px;
  }
  .blank-input:focus { border-color: rgba(96,165,250,.75); box-shadow: 0 0 0 4px rgba(96,165,250,.18); }
  .blank-input.correct { border-color: rgba(16,185,129,.85); box-shadow: 0 0 0 4px rgba(16,185,129,.18); }
  .blank-input.wrong { border-color: rgba(239,68,68,.85); box-shadow: 0 0 0 4px rgba(239,68,68,.18); }
.bottom-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    background: rgba(11,15,20,.78);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--border);
  }
  .bottom-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 12px 16px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
  }
  .status {
    font-size: 12px;
    color: var(--muted);
  }
  .status b { color: var(--text); }
  .right-buttons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
  }
  .divider {
    height: 1px;
    background: var(--border);
    margin: 16px 0;
  }
  .note {
    color: var(--muted);
    font-size: 12px;
    margin: 8px 0 0;
  }
  @media (max-width: 720px) {
    .controls { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>
<header>
  <div class="header-inner">
    <div class="title-row">
      <div>
        <h1>中国近现代史纲要</h1>
        <div class="sub">本页面会把作答自动保存到本机浏览器（localStorage）。可离线打开。</div>
      </div>
      <div class="stats" id="statsTop"></div>
    </div>

    <div class="controls">
      <div class="ctrl">
        <div class="ctrl-row">
          <input id="jumpInput" class="input" placeholder="输入题号并回车跳转（例如：单选 58 输入 58；多选 10 输入 M10）" />
          <button class="btn ghost" id="btnShowAll">显示全部</button>
        </div>
        <div class="note">跳转规则：输入 <b>数字</b> → 单选题；输入 <b>M数字</b> → 多选题。</div>
      </div>
      <div class="ctrl">
        <div class="ctrl-row">
          <button class="btn ghost" id="btnFilterUnanswered">只看未答</button>
          <button class="btn ghost" id="btnFilterWrong">只看错题</button>
          <button class="btn ghost" id="btnToggleAnswers">显示答案</button>
        </div>
        <div class="note">“只看错题”需要先点一次 <b>提交判分</b> 才有意义。</div>
      </div>
    </div>
  </div>
</header>

<div class="wrap">


  <div class="divider"></div>

  <div class="section" id="secSingle">
    <h2>单选题（共 105 题）</h2>
    <div id="singleList"></div>
  </div>

  <div class="divider"></div>

  <div class="section" id="secMulti">
    <h2>多选题（共 45 题）</h2>
    <div id="multiList"></div>
  </div>

  <p class="note">题目与答案来自你上传的《中国近代史纲要.docx》整理（单选 75 + 多选 45），并已将 Word 里的判断题 30 题追加到单选题末尾。</p>
</div>

<div class="bottom-bar">
  <div class="bottom-inner">
    <div class="status" id="statusBar">未判分</div>
    <div class="right-buttons">
      <button class="btn primary" id="btnGrade">提交判分</button>
      <button class="btn" id="btnClear">清空选择</button>
      <button class="btn danger" id="btnReset">清空本页所有保存</button>
    </div>
  </div>
</div>

<script>
const DATA = {"meta":{"title":"中国近现代史纲要","generated":"2026-01-02"},"single":[{"num":1,"stem":"在近代西方列强侵略中国的过程中，外国教会中的某些势力还利用宗教和西学的名义，为资本帝国主义的侵略制造舆论。它们在中国办报纸、杂志，翻译、出版各种书刊。基督教在中国设立的最大的出版机构是（ ）","options":{"A":"强学会","B":"广学会","C":"保国会","D":"万国公会"},"answer":"B"},{"num":2,"stem":"洋务运动主要引进西方的（ ）。","options":{"A":"政治制度","B":"政治思想","C":"文艺理论","D":"器物技术"},"answer":"D"},{"num":3,"stem":"在中国延续了两千多年的封建帝制覆灭的标志是（ ）。","options":{"A":"1912年2月12日，清帝退位","B":"1911年10月10日，武昌起义","C":"1912年3月10日，袁世凯在北京就职","D":"1912年1月1日，中华民国成立"},"answer":"A"},{"num":4,"stem":"中国从封建社会逐步沦为半殖民地半封建社会，中国社会的阶级关系也发生了深刻的变动。近代中国最早产生的新的阶级是（ ）。","options":{"A":"官僚买办资产阶级","B":"工人阶级","C":"民族资产阶级","D":"城市小资产阶级"},"answer":"B"},{"num":5,"stem":"1851年1月，洪秀全率拜上帝教教众在广西省桂平县金田村发动起义，建号太平天国。1864年7月，天京被湘军攻破，太平天国农民战争失败。孙中山认为，太平天国“不懂外交”“不北伐”“读书人不赞成”“大家想做皇帝”，是太平天国失败的重要原因。太平天国的这些失误，从根本上说是由于农民阶级（ ）。","options":{"A":"没有建立同无产阶级紧密结合的统一战线","B":"无法从根本上提出完整的、正确的政治纲领和社会改革方案","C":"无法长期保持领导集团的团结","D":"无法克服小生产者所固有的阶级局限性"},"answer":"D"},{"num":6,"stem":"清政府于1906年宣布“预备仿行宪政”，并于1908 年颁布《钦定宪法大纲》，但预备立宪并没有能够挽救清王朝，反而激化了社会矛盾，加重了危机。其主要原因在于清政府改革的根本目的是（ ）。","options":{"A":"改变中国的社会性质","B":"救亡图存","C":"维护帝国主义的利益","D":"延续其反动统治"},"answer":"D"},{"num":7,"stem":"甲午战败后，李鸿章伤感地说:“我办了一辈子事，练兵也，海军也，都是纸糊的老虎……不过勉强涂饰，虚有其表。”从他的话中，我们能看出洋务运动是一次（ ）。","options":{"A":"失败的资产阶级性质的政治改良运动","B":"失败的封建统治者的自救运动","C":"资产阶级民主革命运动","D":"使中国走上了富强道路的运动"},"answer":"B"},{"num":8,"stem":"维新变法时期，维新派提出的政治主张是（ ）。","options":{"A":"人民民主","B":"君主立宪","C":"民主共和","D":"宪政民主"},"answer":"B"},{"num":9,"stem":"近代中国，一些爱国人士提出过工业救国、教育救国、科学救国等主张，并为此付出过努力，但这些主张并不能从根本上给濒临危亡的中国指明正确的出路。这是因为他们没有认识到 （ ）。","options":{"A":"中国是一个经济政治发展不平衡的国家","B":"中国已经被卷入世界资本主义经济体系和世界市场中","C":"争取民族独立和人民解放是实现民族复兴的前提","D":"资本主义制度已经过时"},"answer":"C"},{"num":10,"stem":"（ ）是近代中国最革命的阶级。","options":{"A":"地主阶级","B":"资产阶级","C":"新兴的工人阶级","D":"农民阶级"},"answer":"C"},{"num":11,"stem":"维新派的变法维新活动引起封建守旧派和反对改变封建政治制度的洋务派的反对，他们利用自己的地位和权力，对维新思想发动攻击。于是维新派与守旧派之间展开了一场激烈论战。这场论战，实质上（ ）。","options":{"A":"是资产阶级思想与封建主义思想在中国的第一次正面交锋","B":"是一场前所未有的、空前深刻的思想解放运动","C":"开创了中国近代向西方学习的新风","D":"是中国人民和中华民族自鸦片战争以来的第一次全面觉醒"},"answer":"A"},{"num":12,"stem":"近代中国，一些爱国人士提出过工业救国、教育救国、科学救国等主张，并为此付出过努力，但这些主张并不能从根本上给濒临危亡的中国指明正确的出路。这是因为他们没有认识到（ ）。","options":{"A":"资本主义制度已经过时","B":"中国是一个经济政治发展不平衡的国家","C":"中国已经被卷入世界资本主义经济体系和世界市场中","D":"争取民族独立和人民解放是实现民族复兴的前提"},"answer":"D"},{"num":13,"stem":"标志中国半殖民地半封建社会完全确立的不平等条约是（ ）。","options":{"A":"《马关条约》","B":"《北京条约》","C":"《辛丑条约》","D":"《天津条约》"},"answer":"C"},{"num":14,"stem":"中国近代史上第一次资产阶级启蒙运动是（ ）。","options":{"A":"维新运动","B":"辛亥革命","C":"洋务运动","D":"五四运动"},"answer":"A"},{"num":15,"stem":"中国同盟会的元老张继曾经这样评述:“孙中山是革命的倡导者，黄兴是革命的实行者，程家柽是革命的组织者。”这是因为早在1894年创立革命团体兴中会时，孙中山就喊出了被誉为时代最强音的口号，即（ ）。","options":{"A":"“君民共主”","B":"“振兴中华”","C":"“民主共和”","D":"“适者生存”"},"answer":"B"},{"num":16,"stem":"北洋军阀政府代表的是（ ）。","options":{"A":"工农利益","B":"民族资产阶级","C":"小资产阶级知识分子利益","D":"大地主和买办资产阶级"},"answer":"D"},{"num":17,"stem":"中国近代史上人民群众第一次大规模的反侵略武装斗争是 （ ）","options":{"A":"三元里人民的抗英斗争","B":"义和团的抗击八国联军斗争","C":"台湾高山族人民的抗日斗争","D":"太平天国的抗击洋枪队斗争"},"answer":"A"},{"num":18,"stem":"《天朝田亩制度》解决的中心问题是（ ）。","options":{"A":"军事问题","B":"土地问题","C":"政治问题","D":"文化问题"},"answer":"B"},{"num":19,"stem":"认识中国近代一切社会问题和革命问题的最基本的依据是（ ）。","options":{"A":"民族资产阶级的软弱性","B":"近代中国的基本国情","C":"资本-帝国主义的侵略","D":"反帝反封建的革命任务"},"answer":"B"},{"num":20,"stem":"太平天国运动之所以是中国农民战争的最高峰,主要因为（ ）。","options":{"A":"对封建王朝的打击空前严重","B":"建立了与清政府对峙的政权","C":"其规模和延续时间均属空前","D":"制定了比较完整的革命纲领"},"answer":"D"},{"num":21,"stem":"1854年，英国外交大臣致函英国驻华公使说:“为了适应外商对农业产品业已增加了的需要……新贸易市场尚待进行。”1856年，法国外长又指令法国驻华代办，强调“商业关系的推广,并说“这是一个关系至高无上利益的问题”。以上材料表明（ ）。","options":{"A":"英法希望加强与中国的贸易往来","B":"英法决定用战争来扩大在华权益","C":"英法策划提出“修改条约”要求","D":"英法企图进一步打开中国市场"},"answer":"D"},{"num":22,"stem":"1851年1月11日，洪秀全在广西领导农民起义的地点是（ ）。","options":{"A":"安庆","B":"武昌","C":"永安","D":"金田村"},"answer":"D"},{"num":23,"stem":"孙中山在《建国方略》中说，国人对待自己革命的态度，以庚子失败为界,“前后相较，差若天渊”。人们对孙中山倡导革命的态度发生根本变化的主要原因是（ ）。","options":{"A":"清政府完全沦为帝国主义统治中国的工具","B":"民族资产阶级革命力量增强","C":"义和团运动的失败","D":"资产阶级维新派的改革未成功"},"answer":"A"},{"num":24,"stem":"1911年10月10日晚，驻武昌的新军工程第八营的革命党人打响了起义的第一枪。起义军一夜之间就占领武昌，取得首义的胜利。武昌起义（ ）。","options":{"A":"成为同盟会成立后发动的第一次武装起义","B":"拉开了中国完全意义上的近代民族民主革命的序幕","C":"使得中国延续了两千多年的封建帝制终于覆灭","D":"使得革命势力发展到了长江和黄河流域的大部分地区"},"answer":"B"},{"num":25,"stem":"太平天国运动最主要的历史功绩是（ ）。","options":{"A":"配合了亚洲第一次民解运动高潮","B":"担负起反侵略反封建的双重任务","C":"提出了第一个在中国发展资本主义的方案","D":"加速了清王朝和整个封建制度的衰落与崩溃"},"answer":"D"},{"num":26,"stem":"中国人民抗日战争是近代以来中国人民反抗外敌入侵持续时间最长、规模最大、牺牲最多的民族解放斗争，也是第一次取得完全胜利的民族解放斗争。中国人民抗日战争取得胜利的决定性因素是（ ）","options":{"A":"中国共产党的中流砥柱作用","B":"世界反法西斯力量的同情和支持","C":"反侵略战争的正义性与进步性","D":"以爱国主义为核心的民族精神"},"answer":"D"},{"num":27,"stem":"1945年，党的七大确立（ ）为党的指导思想，使全党在思想上、政治上、组织上达到空前的统一和团结。","options":{"A":"实事求是","B":"马克思主义","C":"毛泽东思想","D":"列宁主义"},"answer":"C"},{"num":28,"stem":"1924年1月，中国国民党第一次全国代表大会在广州召开，大会通过的宣言对三民主义作出新的解释。新三民主义成为第一次国共合作的政治基础，究其原因是由于新三民主义纲领（ ）。","options":{"A":"体现了联俄联共扶助农工三大革命政策","B":"把民主主义概括为“平均地权”","C":"把斗争的矛头直接指向了北洋军阀","D":"同中国共产党在民主革命阶段的纲领基本一致"},"answer":"D"},{"num":29,"stem":"1925 年毛泽东在《中国社会各阶级的分析》中指出，中国过去一切革命斗争成效甚少，一个重要的原因就在于（ ）。","options":{"A":"没有建立资产阶级共和政府","B":"没有让中国人民的民族意识开始普遍觉醒","C":"没有团结真正的朋友以攻击真正的敌人","D":"没有形成比较完整而明确的民主革命纲领"},"answer":"C"},{"num":30,"stem":"大革命失败后：中国共产党开始了武装反抗国民党反动统治的斗争。然而，南昌起义、秋收起义、广州起义却接连失败了，中国共产党从中得出的最深刻教训是（ ）。","options":{"A":"必须走适合中国国情的革命道路","B":"必须建立党对军队的绝对领导","C":"必须建立新型人民军队","D":"必须武装反抗国民党反动统治"},"answer":"A"},{"num":31,"stem":"1926 年7月，以推翻北洋军阀统治为目标的北伐战争开始。国民革命军在工农群众的支援下，采取各个击破的战略，在不到半年的时间里，基本上摧毁了北洋军阀吴佩孚、孙传芳的主力，革命势力发展到了长江流域和黄河流域的大部分地区。随着北伐的胜利进军，（ ）。","options":{"A":"标志着第一次国共合作圆满成功","B":"中国形成了历史上空前广大的人民解放运动","C":"掀起了全国范围的大革命高潮","D":"国民党在全国范围内建立了自己的统治"},"answer":"B"},{"num":32,"stem":"1922年召开的中共二大明确提出了（ ）。","options":{"A":"土地革命总路线","B":"新民主主义革命总路线","C":"消灭阶级，废除资本私有制的纲领","D":"反帝反封建的民主革命纲领"},"answer":"D"},{"num":33,"stem":"五四运动孕育了伟大的五四精神。习近平总书记指出，面对国家和民族生死存亡，一批爱国青年挺身而出，全国民众奋起抗争，誓言“国土不可断送、人民不可低头”，奏响了浩气长存的爱国主义壮歌。伟大五四精神的核心是（ ）。","options":{"A":"科学和民主精神","B":"爱国主义","C":"集体主义","D":"革命与进步精神"},"answer":"B"},{"num":34,"stem":"五四运动以后，社会主义思潮在中国蓬勃兴起，马克思主义开始在知识界广泛传播。标志着马克思主义在中国进入比较系统的传播阶段的著作是（ ）。","options":{"A":"杨达的翻译著作《唯物史观解说》","B":"杨匏安的《马克思主义》","C":"李大钊的《我的马克思主义观》","D":"陈独秀的《谈政治》"},"answer":"C"},{"num":35,"stem":"五四运动前新文化运动的性质是（ ）","options":{"A":"马克思主义的思想文化运动","B":"新民主主义的思想文化运动","C":"无产阶级的思想文化运动","D":"资产阶级民主主义的思想文化运动"},"answer":"D"},{"num":36,"stem":"二七惨案后，中国共产党意识到中国革命力量远不如帝国主义和封建势力强大，决定采取更为积极的步骤。中共三大正确估计了孙中山的革命立场和国民党进行改革的可能性，做出的决定是（ ）。","options":{"A":"确认了联俄、联共、扶助农工的三大革命政策","B":"提出建立民主的联合战线的决议","C":"必须在统一战线中坚持独立自主原则","D":"全体共产党员以个人名义加入国民党"},"answer":"D"},{"num":37,"stem":"中国共产党成立以后，就采用了民族资产阶级、小资产阶级的政党和政治派别没有采用过也不可能采用的革命方法是（ ）。","options":{"A":"议会斗争的方法","B":"君主立宪的方法","C":"革命战争的方法","D":"群众路线的方法"},"answer":"D"},{"num":38,"stem":"延安整风运动最主要的任务是（ ）","options":{"A":"反对“左”倾机会主义","B":"反对主观主义以整顿学风","C":"反对党八股以整顿文风","D":"反对宗派主义以整顿党风"},"answer":"B"},{"num":39,"stem":"独立自主是毛泽东思想活的灵魂，毛泽东在《论本本主义》一文中指出,“中国革命斗争的胜利要靠中国同志了解中国情况”，这是最初对独立自主思想的明确表述，毛泽东作出这一表述是为了（ ）。","options":{"A":"巩固和发展统一战线","B":"防止各种非无产阶级思想的侵蚀","C":"改变红军中残留的旧军队的不良作风","D":"反对党内存在的教条主义倾向"},"answer":"D"},{"num":40,"stem":"1914 年至 1918 年的第一次世界大战，是一场空前残酷的大屠杀。它改变了世界的政治格局，也改变了各帝国主义国家在中国的利益格局，对中国产生了巨大的影响。第一次世界大战使中国的先进分子（ ）。","options":{"A":"对中国传统文化进行全盘否定","B":"率先举起马克思主义旗帜","C":"认识到必须优先改造国民性","D":"对西方资产阶级民主主义产生怀疑"},"answer":"D"},{"num":41,"stem":"1921年7月23日，中国共产党第一次全国代表大会在上海举行，从此，中国人民有了一个先进的坚强的政党作为凝聚自己力量的领导核心。下列关于中共一大的说法错误的是（ ）。","options":{"A":"提出了以无产阶级军队推翻资产阶级","B":"决定首先集中精力组织工人","C":"选举了由陈独秀、张国焘、李达组成的中央局","D":"提出了反帝反封建的民主革命纲领"},"answer":"D"},{"num":42,"stem":"1927 年9 月29 日，毛泽东领导起义军在江西省永新县三湾村进行了著名的三湾改编，从组织上确立了党对军队的领导。三湾改编是（ ）。","options":{"A":"中国共产党和红军建设的纲领性文献","B":"建设无产阶级领导的新型人民军队的重要开端","C":"中国共产党创建人民军队和武装夺取政权的开端","D":"由大革命失败到土地革命战争兴起的历史性转变"},"answer":"B"},{"num":43,"stem":"陈独秀在《青年杂志》发刊词中宣称:“盖改造青年之思想，辅导青年之修养，为本志之天职。批评时政，非其旨也。”此时陈独秀把注意力倾注于思想变革的原因是（ ）。","options":{"A":"他认定改造国民性是政治变革的前提","B":"他对政治问题不感兴趣","C":"他对资产阶级民主主义产生了怀疑","D":"他认为批评时政不利于改造青年思想"},"answer":"A"},{"num":44,"stem":"为了贯彻执行全面抗战路线，中国共产党作出了开辟敌后战场的战略决策。1937年9月，八路军第一一五师主力在晋东北平型关附近伏击日军，歼敌 1000 余人，击毁车辆 100 多辆，史称平型关大捷。平型关的这场胜利（ ）。","options":{"A":"是抗日相持阶段中国军队取得的重大胜利","B":"是一场大规模的以破袭敌人交通线为重要目标的进攻战役","C":"是国共两党军队抗日合作配合最好的一次战役","D":"粉碎了日军不可战胜的神话"},"answer":"D"},{"num":45,"stem":"经过宣传教育，觉悟的工人有了组织起来的要求，工人工会在全国相继成立。其中，中国共产党早期组织领导的第一个工会是（ ）。","options":{"A":"工人纠察队","B":"科学补习所","C":"上海机器工会","D":"长辛店工人俱乐部"},"answer":"C"},{"num":46,"stem":"毛泽东在《论持久战》中指出，中国抗战争取胜利的最关键的阶段是（ ）。","options":{"A":"战略反攻阶段","B":"战略防御阶段","C":"战略相持阶段","D":"战略决战阶段"},"answer":"C"},{"num":47,"stem":"中国共产党在抗日根据地为适当调节各抗日阶层的利益，实行了新的土地政策–停止没收地主土地，农民要交租交息以照顾地主和富农的利益。这样做的主要目的是（ ）。","options":{"A":"彻底消灭农村封建剥削和土地问题","B":"改善农民的生活","C":"联合地主阶级共同抗日","D":"推进“耕者有其田”的政策"},"answer":"C"},{"num":48,"stem":"毛泽东同志指出:“日本敢于欺负我们，主要的原因在于中国民众的无组织状态。克服了这一缺点，就把日本侵略者置于我们数万万站起来了的人民之前，使它像一匹野牛冲入火阵，我们一声唤也要把它吓一大跳，这匹野牛就非烧死不可。”在毛泽东看来，要打倒日本帝国主义，关键在于（ ）。","options":{"A":"通过土地革命改善工农大众的生活","B":"坚持统一战线中无产阶级的领导权","C":"在敌后战场发动独立自主的游击战争","D":"发动全民族走向全面抗战的路线"},"answer":"D"},{"num":49,"stem":"1931年9月18日，日本关东军自行炸毁沈阳北郊柳条湖附近南满铁路的一段路轨，反诬是中国军队所为，随即以此为借口，炮轰北大营，进攻沈阳城，震惊中外的九一八事变由此爆发。 九一八事变（ ）","options":{"A":"标志着中国人民抗日救亡运动新高潮的到来","B":"成为中国人民全面抗击日本侵略者的起点","C":"揭开了世界反法西斯战争的序幕","D":"开辟了世界反法西斯战争的东方主战场"},"answer":"C"},{"num":50,"stem":"中国共产党领导第一次工人运动高潮的顶点是（ ）。","options":{"A":"京汉铁路工人罢工","B":"安源路矿工人罢工","C":"香港海员罢工","D":"开滦五矿工人罢工"},"answer":"A"},{"num":51,"stem":"解放战争时期，在国民党统治地区，以学生运动为先导的人民民主运动迅速地发展起来，成为配合人民解放战争的第二条战线。第二条战线形成的最主要原因是（ ）。","options":{"A":"国民党的统治不得人心","B":"学生运动的高涨","C":"第三条道路的幻灭","D":"土地改革与农民的广泛发动"},"answer":"A"},{"num":52,"stem":"中国共产党第十三次全国代表大会于1987年10月25日至11月1日在北京举行。大会首次提出（ ）理论。","options":{"A":"社会主义市场经济理论","B":"中国特色社会主义理论","C":"中国特色社会经济理论","D":"社会主义初级阶段理论"},"answer":"D"},{"num":53,"stem":"中国共产党领导人民进行社会主义建设，有改革开放前和改革开放后两个历史时期，这是两个相互联系又有重大区别的时期，但本质上都是（ ）。","options":{"A":"中国共产党领导人民进行社会主义建设的实践探索","B":"中国共产党革命和建设的伟大实践","C":"中国特色社会主义理论指导下的伟大实践","D":"中国特色社会主义新时代的产物"},"answer":"A"},{"num":54,"stem":"（ ），是当代中国共产党人回答和解决关乎人类前途命运的时代之问的中国方案，是应对人类共同挑战、建设更加繁荣美好世界的人间正道，也是新时代对外工作的总目标。","options":{"A":"美丽世界","B":"一带一路","C":"推动构建人类命运共同体","D":"合作共赢"},"answer":"C"},{"num":55,"stem":"党在过渡时期总路线的主要内容被概括为“一化三改”。“一化”即（ ）。","options":{"A":"社会主义工业化","B":"工业现代化","C":"资本主义工业化","D":"四个现代化"},"answer":"A"},{"num":56,"stem":"1950年9月30日，周恩来严正地警告美国：“中国人民决不能容忍外国的侵略，也不能听任帝国主义者对自己的邻人肆行侵略而置之不理。”为此，中国采取的行动是（ ）","options":{"A":"援越抗美","B":"抗美援朝","C":"参加万隆会议","D":"参加日内瓦会议"},"answer":"B"},{"num":57,"stem":"1935 年 12月,中共中央在陕北瓦窑堡召开政治局扩大会议,提出党的基本策略任务是（ ）。","options":{"A":"在根据地实行减租减息的土地政策","B":"保持党在思想上、政治上和组织上的独立性","C":"建立广泛的抗日民族统一战线","D":"在敌后广泛开展游击战和运动战"},"answer":"C"},{"num":58,"stem":"在解放战争胜利发展的同时，解放区开展了轰轰烈烈的土地改革运动。中国共产党在西柏坡召开全国土地会议，会议制定和通过了《中国土地法大纲》。《中国土地法大纲》是一个彻底反封建的土地革命纲领，是因为（ ）。","options":{"A":"主张“地主不分田，富农分坏田”","B":"规定没收的一切土地归政府所有","C":"普遍实现了减租减息的政策","D":"废除了封建性及半封建性剥削的土地制度"},"answer":"D"},{"num":59,"stem":"制定一部切实可行的发展国民经济的中期计划,是完成过渡时期总路线规定的工业化主体任务的重要步骤。为准备进行有计划的经济建设,我国从1951年着手编制第一个五年计划。\n1955 年7月召开的一届全国人大二次会议通过了这个计划。“一五”计划确定的经济建设指\n导方针突出的核心要点是集中主要力量（ ）。","options":{"A":"保证在发展生产的基础上逐步提高人民的物质生活和文化生活的水平","B":"保证国民经济中社会主义成分的比重稳步增长","C":"发展重工业,建立国家工业化和国防现代化的初步基础","D":"发展交通运输业、轻工业、农业和商业,相应地培养建设人才"},"answer":"C"},{"num":60,"stem":"1935 年,电影《风云儿女》一公映,主题歌《义勇军进行曲》便成为时代的最强音。歌曲发出了中华民族不甘沦亡的怒吼,吹响了中华儿女万众一心、血战到底的战斗号角。《义勇军进行曲》之所以发出“中华民族到了最危险的时候”的呐喊,最重要的原因是（ ）。","options":{"A":"国际联盟和英美等国政府采取对日姑息、纵容的政策","B":"国民党政府长期奉行“攘外必先安内”方针,对日本的大举侵略一再退让","C":"中国长期缺乏有力的国际援助","D":"日本大举侵华,妄图把中国变为其独占的殖民地"},"answer":"D"},{"num":61,"stem":"经过长期努力，中国特色社会主义进入了新时代，这是我国发展新的（ ）","options":{"A":"历史方位","B":"历史方向","C":"未来方位","D":"未来方向"},"answer":"A"},{"num":62,"stem":"党的十四大明确提出我国经济体制改革的目标是建立社会主义市场经济体制，这一决策（ ）","options":{"A":"实现了从温饱到小康的跨越","B":"推动改革开放和现代化建设进入新阶段","C":"标志原计划经济体制彻底废除","D":"确立了社会主义初级阶段基本路线"},"answer":"B"},{"num":63,"stem":"中国共产党第十九次全国代表大会，是在全面建成小康社会（ ）阶段、中国特色社会主义进入新时代的关键时期召开的一次十分重要的大会。","options":{"A":"新的","B":"重要","C":"关键","D":"决胜"},"answer":"D"},{"num":64,"stem":"1954 年9月15日,第一届全国人民代表大会第一次会议顺利开幕。9月28日,会议在完成预定的议程后胜利闭幕。这次会议是我国人民民主建设的重要里程碑,标志着新中国（ ）。","options":{"A":"根本政治制度的正式确立","B":"国家结构形式的正式确立","C":"新型政党制度的正式确立","D":"人民民主专政制度的确立"},"answer":"A"},{"num":65,"stem":"1979年3月30日,邓小平在党的理论工作务虚会上发表《坚持四项基本原则》的讲话。他指出:坚持社会主义道路,坚持人民民主专政,坚持共产党的领导,坚持马克思列宁主义、毛泽东思想这四项基本原则,“是实现四个现代化的根本前提”。“如果动摇了这四项基本原则中的任何一项,那就动摇了整个社会主义事业,整个现代化建设事业。”他还提出一个重要思想,“现在搞建设,也要适合中国情况,走出一条中国式的现代化道路。”这表明（ ）。","options":{"A":"中国共产党所领导的改革开放从一开始就具有明确的社会主义方向","B":"马克思主义同中国实际“第二次结合”任务的正式提出","C":"中国式现代化只能基于自身国情,不能借鉴他国经验","D":"“中国特色社会主义”从此成为我们党的全部理论和实践创新的主题"},"answer":"A"},{"num":66,"stem":"中共八大正确分析了国内形势和主要矛盾的变化，明确提出新形势下党和人民的主要任务。在新的生产关系下，党和人民的根本任务是（ ）。","options":{"A":"保护和发展生产力","B":"在综合平衡中稳步前进","C":"调动一切积极因素来建设社会主义","D":"向现代科学进军"},"answer":"A"},{"num":67,"stem":"中国革命的胜利，结束了100多年来中华民族遭受资本-帝国主义侵略和中国各族人民遭受资本-帝国主义同封建统治阶级联合压迫与剥削的历史，结束了国家战乱频仍、四分五裂的局面。中国革命之所以能够走上胜利发展的道路，从根本上说，是由于有了（ ）。","options":{"A":"一条正确的革命道路","B":"一支人民的军队","C":"广泛的统一战线","D":"中国共产党的领导"},"answer":"D"},{"num":68,"stem":"毛泽东在《关于正确处理人民内部矛盾的问题》一文中明确提出,正确处理人民内部矛盾的问题是社会主义国家政治生活的主题。这一论断的根本着眼点,在于（ ）。","options":{"A":"科学揭示社会主义社会发展的动力","B":"调动一切积极因素,团结一切可以团结的力量,把全党的注意力转到社会主义建设上来","C":"克服领导工作中还存在的官僚主义等问题","D":"帮助广大人民在我国的政治生活中判断人们言论和行动的是非"},"answer":"B"},{"num":69,"stem":"建设有中国特色社会主义的命题是在（ ）提出的。","options":{"A":"党的十四大","B":"党的十二大","C":"党的十三大","D":"党的十五大"},"answer":"B"},{"num":70,"stem":"庆祝新中国成立70周年前夕，习近平总书记专程来到位于北京西北郊的香山革命纪念地。香山是新中国启航的地方，是中国共产党人“进京赶考”的首站。1949年3月，中央领导同志率领中共中央机关和中国人民解放军总部，从西柏坡赶赴北平，进驻北平香山，标志（ ）。","options":{"A":"帝国主义在中国的统治由发展到消灭的转折点","B":"延续22年之久的国民党反动统治的覆灭","C":"中国革命重心由农村转向城市","D":"中国共产党成为全国范围的执政党"},"answer":"C"},{"num":71,"stem":"1937年8月22日至25日,中共中央在陕北洛川召开政治局扩大会议(洛川会议)通过了\n《中国共产党抗日救国十大纲领》和《中共中央关于目前形势与党的任务的决定》,这标志着（ ）。","options":{"A":"党确立了建立广泛的抗日民族统一战线的策略","B":"党制定了关于根据地建设的基本方针","C":"党的全面抗战路线的正式形成","D":"党的“逼蒋抗日”总方针的明确提出"},"answer":"C"},{"num":72,"stem":"1947 年6月底，根据中共中央的决策和部署，以刘伯承、邓小平率领的晋冀鲁豫野战军为主力实施中央突破，千里跃进大别山;陈毅、粟裕指挥的华东野战军主力为东路，挺进苏鲁豫皖地区:陈康、谢富治指挥的晋冀鲁豫野战军一部为西路，挺进豫西，三路大军相互策应，机动歼敌，迫使国民党军处于被动地位，这表明（ ）。","options":{"A":"人民解放军在数量上已经超过国民党军队","B":"人民解放军同国民党军队进行战略决战的时机已经成熟","C":"人民解放战争战略进攻的序幕由此展开","D":"人民解放战争进入战略相持阶段"},"answer":"C"},{"num":73,"stem":"新中国成立初期，面临着许多严重的困难和一些紧迫的问题。党和政府教育广大干部和党员必须经受住执政的考验、接管城市的考验和生活环境变化的考验。1951年年底到1952年10月，中国共产党在党政军机关开展“三反”运动。这一运动（ ）","options":{"A":"为资本主义工商业改造和国家大规模经济建设奠定了基础","B":"是以反贪污、反浪费、反官僚主义为核心的群众性政治运动","C":"基本上肃清了国民党遗留在大陆的反动势力","D":"制定了党在新中国成立初期的战略策略方针"},"answer":"B"},{"num":74,"stem":"1953年，新中国开始实施发展国民经济的第一个五年计划。“一五”计划期间，在苏联的援助下中国实施建设了一大批基础性的重点工程，如鞍山、包头、武汉钢铁基地等。“一五”计划确定的经济建设指导方针，突出的核心要点是（ ）。","options":{"A":"集中主要力量发展重工业，建立国家工业化和国防现代化的初步基础","B":"完成了从个体劳动向集体经营的历史性转变","C":"要在三年左右的时间内，争取国家财政经济状况的基本好转","D":"实现了从新民主主义到社会主义的过渡"},"answer":"A"},{"num":75,"stem":"中国式现代化是新时代推进中华民族伟大复兴的正确道路，其形成离不开党长期的探索实践。下列哪一会议标志着中国进入全面建成小康社会决定性阶段，为中国式现代化奠定重要基础（ ）。","options":{"A":"中共十九大","B":"中共十七大","C":"中共二十大","D":"中共十八大"},"answer":"D"},{"num":76,"stem":"近代中国诞生的新的被压迫阶级是工人阶级。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":77,"stem":"赫德自1863年任总税务司至1908年回国，掌握中国海关大权达40余年。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":78,"stem":"辛亥革命失败的根本原因是：在帝国主义时代、半殖民地半封建的中国，资本主义建国方案行不通。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":79,"stem":"中国资产阶级包括官僚资产阶级、民族资产阶级和小资产阶级。（ ）","options":{"A":"对","B":"错"},"answer":"B"},{"num":80,"stem":"同盟会成立后发动的一系列武装起义中影响最大的是萍浏醴起义。（ ）","options":{"A":"对","B":"错"},"answer":"B"},{"num":81,"stem":"辛亥革命是一次比较完全意义上的资产阶级革命民主革命。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":82,"stem":"近代中国海军起步于洋务运动；19世纪80年代规模最大的是北洋舰队。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":83,"stem":"19世纪60年代，洋务派举办的洋务活动以民用企业为重点。（ ）","options":{"A":"对","B":"错"},"answer":"B"},{"num":84,"stem":"南京临时政府是一个资产阶级共和国性质的革命政权。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":85,"stem":"认识中国近代社会的性质，是认识中国近代一切社会问题和革命问题的最基本的依据。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":86,"stem":"在土地革命战争时期建立的苏维埃政权的性质是工农民主专政。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":87,"stem":"南昌起义第一次打出了工农革命军的旗帜。（ ）","options":{"A":"对","B":"错"},"answer":"B"},{"num":88,"stem":"中共六届六中全会标志着党在政治上思想上组织上走向成熟。（ ）","options":{"A":"对","B":"错"},"answer":"B"},{"num":89,"stem":"全民族抗战伊始，中国共产党就提出必须在统一战线中坚持的原则是独立自主。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":90,"stem":"1945年9月2日，日本代表在投降书上签字，这是抗战取得完全胜利的重要标志。（ ）","options":{"A":"对","B":"错"},"answer":"B"},{"num":91,"stem":"农村包围城市，武装夺取政权的革命道路理论的提出标志着毛泽东思想的初步形成。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":92,"stem":"新三民主义的“新”在民族主义中体现在突出了反对帝国主义的内容。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":93,"stem":"新民主主义革命和旧民主主义革命的根本区别在于革命的动力不同。（ ）","options":{"A":"对","B":"错"},"answer":"B"},{"num":94,"stem":"中国革命的三大法宝是武装斗争、统一战线、根据地建设。（ ）","options":{"A":"对","B":"错"},"answer":"B"},{"num":95,"stem":"古田会议确立了思想建党、政治建军的原则，阐述了加强党的思想建设的极端重要性。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":96,"stem":"1953年，我国开始执行第一个五年计划，在优先发展重工业的同时，对农业、手工业、资本主义工商业进行改造。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":97,"stem":"党的十五大是党在新世纪召开的第一次全国代表大会，明确回答了新世纪新阶段中国共产党举什么旗、走什么路、实现什么样的发展目标等重大问题。（ ）","options":{"A":"对","B":"错"},"answer":"B"},{"num":98,"stem":"中共七届二中全会的召开，标志着中国革命的中心从农村转到城市。（ ）","options":{"A":"对","B":"错"},"answer":"B"},{"num":99,"stem":"党的十一届三中全会的胜利召开，实现了历史性的伟大转折。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":100,"stem":"1946年6月，国民党军队挑起全面内战的起点是大举围攻中原解放区。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":101,"stem":"随着社会主义改造的完成，以生产资料公有制、按劳分配和计划经济体制为特征的社会主义经济制度建立起来，这是中国进入社会主义社会最主要的标志。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":102,"stem":"1956年，中共八大召开，会议正确分析了当时中国社会的主要矛盾和主要任务，并作出了改革开放的伟大决策。（ ）","options":{"A":"对","B":"错"},"answer":"B"},{"num":103,"stem":"台湾问题是中国的内政。（ ）","options":{"A":"对","B":"错"},"answer":"A"},{"num":104,"stem":"《关于正确处理人民内部矛盾的问题》是以毛泽东为主要代表的中国共产党人开始探索适合中国国情的社会主义建设道路的标志。（ ）","options":{"A":"对","B":"错"},"answer":"B"},{"num":105,"stem":"20世纪70年代，中美关系缓和是中国外交的重大成果。中美两国一致认为遵循“不结盟”原则是改善关系的基本前提，这一前提最终促使两国关系正常化。（ ）","options":{"A":"对","B":"错"},"answer":"B"}],"multi":[{"num":1,"stem":"鸦片战争成为中国近代史的起点，这是因为随着西方列强的入侵，（ ）。","options":{"A":"中国逐步成为半殖民地半封建国家","B":"中国社会主要矛盾的变化","C":"中国革命属于世界无产阶级革命的组成部分","D":"中国逐渐开始了反帝反封建的资产阶级民主革命"},"answer":"ABD"},{"num":2,"stem":"孙中山在 1905 年的《民报》发刊词中认为,“罗马灭亡，民族主义兴，而欧洲各国以独立”民族主义就是“驱除鞑虏，恢复中华”，推翻清朝统治，并争取独立自主。但这并不能给中国人民的民族斗争指明正确的方向，因为这一主义（ ）。","options":{"A":"放松了对汉族封建势力的警惕","B":"实际上推行的是君主立宪和开明专制","C":"具有相当程度的软弱性","D":"放走了中国人民的首要的、最大的敌人"},"answer":"ACD"},{"num":3,"stem":"戊戌维新运动在中国近代史上的重大历史意义，主要体现在戊戌维新运动是一场（ ）。","options":{"A":"思想启蒙运动","B":"资产阶级性质的政治改革运动","C":"反对帝国主义的革命运动","D":"爱国救亡运动"},"answer":"ABD"},{"num":4,"stem":"资本-帝国主义列强在对中国实行军事侵略、政治控制、经济掠夺的同时，还对中国进行文化渗透，文化渗透具体包括（ ）。","options":{"A":"以传教为掩护进行间谍活动","B":"创办《万国公报》","C":"允许外国公使常驻北京","D":"炮制了“中国威胁论”"},"answer":"ABD"},{"num":5,"stem":"1905年孙中山在《民报》发刊词中，将同盟会纲领概括为（ ）。","options":{"A":"民治主义","B":"民生主义","C":"民族主义","D":"民权主义"},"answer":"BCD"},{"num":6,"stem":"19世纪70至80年代，帝国主义列强从侵占中国周边邻国发展到蚕食中国边疆地区，使中国陷入“边疆危机”。“边疆危机”的主要表现有 （ ） 。","options":{"A":"俄国从中亚入侵新疆","B":"英国从印度侵入西藏，从缅甸入侵云南","C":"法国从越南侵犯广西","D":"日本吞并琉球、侵犯中国台湾"},"answer":"ABCD"},{"num":7,"stem":"毛泽东说:“我国从 19 世纪 40 年代起，到 20 世纪 40 年代中期，共计 105 年的时间，全世界几乎一切大中小帝国主义国家都侵略过我国，都打过我们，除最后一次，即抗日战争，由于国内外各种原因以日本帝国主义投降告终以外，没有一次战争不是以我国失败、签订丧权辱国条约而告终。”导致近代中国历次反侵略战争失败的原因包括（ ）。","options":{"A":"本国封建势力与帝国主义相勾结","B":"经济技术落后","C":"民族资产阶级的两面性","D":"社会制度腐败"},"answer":"BD"},{"num":8,"stem":"太平天国农民战争爆发的原因有（ ）。","options":{"A":"鸦片战争失败以后，为支付对列强的巨额赔款，同时也为了弥补财政亏空，清政府加重了赋税的征收","B":"各级官吏在征收钱粮时往往浮收勒扣，横征暴敛，农民的负担更为加重","C":"由于西方资本主义的入侵，中国的农业和家庭手工业相结合的自然经济逐渐解体","D":"满汉民族矛盾"},"answer":"ABC"},{"num":9,"stem":"19世纪90年代，资产阶级维新派与封建守旧派激烈论战主要问题是（ ）。","options":{"A":"要不要实行民主共和","B":"要不要废八股、改科举和兴西学","C":"要不要兴民权、设议院，实行君主立宪","D":"要不要变法"},"answer":"BCD"},{"num":10,"stem":"鸦片战争后中国被纳入了欧美资本主义的世界条约体系 ，英国等西方列强在中国攫取了大量侵略特权，主要有 （ ） 。","options":{"A":"外国人在华不受中国法律管束，享受领事裁判权，破坏了中国的司法主权","B":"协定关税，破坏了中国的关税主权","C":"外国船舰可在中国领海航行，破坏了中国的领海主权","D":"割占香港岛，破坏了中国的主权和领土完整"},"answer":"ABCD"},{"num":11,"stem":"1894年，日本以突然袭击清朝陆海军的方式挑起了第一次大规模的侵华战争，史称中日甲午战争。中日甲午战争是日本对外侵略扩张,“开拓万里波涛，布国威于四方”的必然产物，清朝在战争中惨败。中日甲午战争的惨败（ ）。","options":{"A":"掀起了列强瓜分中国的狂潮","B":"使中国陷入“边疆危机”","C":"造成了新的民族危机，激发了新的民族觉醒","D":"标志着以“自强”“求富”为目标的洋务运动的失败"},"answer":"ACD"},{"num":12,"stem":"毛泽东说：“民国元年的《中华民国临时约法》，在那个时期是一个比较好的东西。”《中华民国临时约法》作为第一部具有资产阶级共和国宪法性质的法典，其进步性表现在（ ）。","options":{"A":"制定了满足农民土地要求的政策和措施","B":"不承认清政府与列强所签订的一切不平等条约","C":"带有鲜明的革命性、民主性","D":"确认了资产阶级共和国的政治制度"},"answer":"CD"},{"num":13,"stem":"资产阶级革命派的骨干力量是（ ）。","options":{"A":"工农阶级","B":"小资产阶级知识分子","C":"地主阶级","D":"资产阶级知识分子"},"answer":"BD"},{"num":14,"stem":"辛亥革命的爆发，是中国社会矛盾运动的必然产物，是当时中国人民争取民族独立、振兴中华深切愿望的集中反映，也是当时中国人民为救亡图存而前赴后继顽强斗争的集中体现。辛亥革命爆发的历史条件有（ ）。","options":{"A":"资产阶级革命派具备了阶级基础且形成了骨干力量","B":"民族危机加深，社会矛盾激化","C":"清末“新政”的破产","D":"学习西方的科学技术，巩固边防"},"answer":"ABC"},{"num":15,"stem":"在清政府镇压太平天国农民战争的过程中和第二次鸦片战争战败后，洋务派发起了一场以“自强”“求富”为目标的洋务运动。这场运动（ ）。","options":{"A":"冲击了“重农抑商”的传统价值观","B":"进一步传播了西方资产阶级社会政治学说","C":"实现了中国向近代化转型的目标","D":"对早期工业和民族资本主义的发展起了促进作用"},"answer":"AD"},{"num":16,"stem":"在战略防御阶段，以国民党军队为主体的正面战场，担负了抗击日军战略进攻的主要任务。尽管国民党军队在抗战初期对日作战比较积极比较努力，但是国民党正面战场除台儿庄战役取得大捷外，其他战役几乎都是以退却、失败而结束。造成这种状况的原因是（ ）","options":{"A":"不敢放手发动和武装民众","B":"蒋介石集团实行的是片面抗战路线","C":"敌我力量对比悬殊","D":"在战略战术上，进行单纯的阵地防御战"},"answer":"ABCD"},{"num":17,"stem":"大革命是在国共合作的条件下进行的，没有国共合作，就不会在短时间内掀起这样一场革命。在这场革命中，中国共产党发挥着独特的、不可代替的作用。没有中国共产党，就不会有这场大革命。这是因为中国共产党（ ）。","options":{"A":"是国共合作的倡导者和统一战线的领导者","B":"是人民群众的主要发动者和组织者","C":"提出了反对帝国主义、反对军阀的政治口号","D":"帮助和推动了工农革命军的建立"},"answer":"BC"},{"num":18,"stem":"1941年1月，震惊中外的皖南事变爆发后,《新华日报》刊出周恩来的题词手迹:“为江南死国难者志哀!”“千古奇冤，江南一叶;同室操戈，相煎何急?!”大敌当前，中国共产党以民族利益为重，坚持正确的方针和原则，避免了抗日民族统一战线的破裂。这些方针和原则包括（ ）。","options":{"A":"针锋相对，寸土必争","B":"又联合又斗争","C":"有理、有利、有节","D":"发展进步势力，争取中间势力，孤立顽固势力"},"answer":"BCD"},{"num":19,"stem":"毛泽东在《论人民民主专政》一文中指出:“十月革命-声炮响， 给中国送来了马克思列宁主义。”这是说（ ）","options":{"A":"十月革命给予中国人一个启示，即经济文化落后的国家也可以用社会主义思想指引自己走向解放之路","B":"十月革命以后，马克思主义才开始在中国传播","C":"资本主义制度并不是永恒的，无产阶级和其他劳动群众完全可以依靠自身的力量创造出维护绝大多数人利益的崭新的社会制度","D":"十月革命推动中国的先进分子把自己的目光从西方转向东方，从资产阶级民主主义转向社会主义"},"answer":"ACD"},{"num":20,"stem":"抗日民主根据地是贯彻和实现中国共产党全面抗战路线、坚持抗战和争取胜利的坚强阵地。根据地建设的首要任务就是加强民主政权的建设。抗日民主根据地政权（ ）。","options":{"A":"在政府工作人员分配上实行“三三制”原则","B":"在少数民族聚居地区试行民族区域自治","C":"是工农民主专政性质的政权","D":"普遍采取民主集中制的组织方式"},"answer":"ABD"},{"num":21,"stem":"1927年10月：毛泽东率领经“三湾改编”后的秋收起义部队到达井冈山，先后在宁冈、永新、茶陵、遂川等县恢复和建立了党组织，发展武装力量，开展游击战争，领导农民打土豪、分田地，建立红色政权，实行工农武装割据，创立了党领导下的第一个农村革命根据地。井冈山革命根据地创建的意义有（ ）","options":{"A":"代表了大革命失败后中国革命发展的方向","B":"开辟了一条在敌我力量悬殊情况下，保存和发展革命力量的新道路","C":"点燃了“工农武装割据”的星星之火","D":"使中国革命的重心从乡村转移到城市"},"answer":"ABC"},{"num":22,"stem":"南昌起义，是1927 年8 月1 日在江西南昌由中国共产党领导的军队针对中国国民党的分共政 策而发起的武装反抗事件。南昌起义的历史意义包括（ ）","options":{"A":"打响了武装反抗国民党反动统治的第一枪","B":"成为中国共产党独立领导革命战争、创建人民军队和武装夺取政权的伟大开端","C":"是从大革命失败到土地革命战争兴起的转折点","D":"开辟了农村包围城市的道路"},"answer":"AB"},{"num":23,"stem":"习近平总书记指出:“中国共产党是为中国人民谋幸福、为中华民族谋复兴的党，也是为人类谋进步、为世界谋大同的党。坚持胸怀天下，是习近平新时代中国特色社会主义思想世界观和方法论的重要内容，充分彰显了中国共产党的天下情怀、国际视野、世界使命和大党担当。”坚持胸怀天下的重要性在于（ ）。","options":{"A":"它是党和人民始终立于不败之地的重要保证","B":"它是党和人民事业不断成功的根本动力","C":"它是党始终掌握历史主动、走在时代前列的基本途径","D":"它是党和人民长期积累的宝贵经验和共同创造的精神财富"},"answer":"ABCD"},{"num":24,"stem":"习近平总书记指出：“中国共产党的中流砥柱作用是中国人民抗日战争胜利的关键。近代以后，中国人民历次反侵略战争失败的一个重要原因：是政治统治集团的腐朽无能和民族内部软弱涣散。中国共产党人以自己的政治主张、坚定意志、模范行动，支撑起全民族救亡图存的希望，引领着夺取战争胜利的正确方向，成为夺取战争胜利的民族先锋。”这种“中流砥柱作用”主要表现在（ ）","options":{"A":"在正面战场发挥了主力军作用","B":"倡导建立抗日民族统一战线","C":"开辟了敌后战场，抗击了大量日军","D":"坚持全面抗战路线，制定持久战的战略"},"answer":"BCD"},{"num":25,"stem":"1936年10 月，红二、红四方面军先后同红一方面军在甘肃会宁、静宁将台堡（今属宁夏回族 自治区）会师。至此，三大主力红军的长征胜利结束。红军的长征（ ）","options":{"A":"开始了从大革命失败到土地革命战争兴起的转折","B":"宣告了中国共产党和红军肩负着民族希望胜利实现了北上抗日的战略转移","C":"宣告了国民党反动派消灭中国共产党和红军的图谋彻底失败","D":"实现了中国共产党和中国革命事业从挫折走向胜利的伟大转折"},"answer":"BCD"},{"num":26,"stem":"1936年12月12日，张学良和杨虎城为了达到劝谏蒋介石改变“攘外必先安内”的既定国策，停止内战，一致抗日的目的，在西安发动“兵谏”;25日，在中共中央和周恩来的主导下：蒋介石接受了“停止内战，联共抗日”的主张，西安事变最终得到和平解决。西安事变的和平解决（ ）","options":{"A":"成为时局转化的枢纽","B":"十年内战局面基本结束","C":"国内和平 初步实现","D":"开启了全面的全民族抗战新阶段"},"answer":"ABC"},{"num":27,"stem":"近代以来，为挽救国家危亡，中国先进分子曾历尽千辛万苦，向西方国家寻找真理。但是，中国人学习西方的努力在实践中却一再碰壁。1915 年新文化运动的兴起具有深远的影响,其重要性表现在（ ）。","options":{"A":"为人们提供了一种思想武器去认识中国、去有效地对中国社会进行改造","B":"在社会上掀起了一股生机勃勃的思想解放潮流，冲决了禁锢人们思想的闸门","C":"为马克思主义在中国的广泛传播准备了思想和文化的条件","D":"是中国历史上一次前所未有的启蒙运动和空前深刻的思想解放运动"},"answer":"BCD"},{"num":28,"stem":"1945年4月23日至6月11日，中国共产党第七次全国代表大会在延安举行。毛泽东在会上作了题为《论联合政府》的书面报告和《愚公移山》的闭幕词。中共七大（ ）。","options":{"A":"在全党确立起了实事求是的马克思主义思想路线","B":"概括了党在长期奋斗中形成的三大优良传统作风","C":"制定了党的政治路线及其实现的正确纲领和策略","D":"将毛泽东思想规定为党的一切工作的指针"},"answer":"BCD"},{"num":29,"stem":"五四运动后，社会主义思潮在中国蓬勃兴起，马克思主义开始在知识界传播。中国早期的马克思主义者们掀起了一场研究和传播马克思主义的思想运动。这一运动的特点包括（ ）。","options":{"A":"已经认识到马克思主义中国化的重要性","B":"重视对马克思主义基本理论的学习","C":"注意从中国的实际出发，学习、运用马克思主义","D":"开始提出知识分子应当同劳动群众相结合的思想"},"answer":"BCD"},{"num":30,"stem":"大革命是中国人民在中国共产党和中国国民党合作领导下进行的反帝反封建的革命斗争。在这场革命中，中国共产党人进行了轰轰烈烈的革命工作，在中国革命史上写下了光辉的一页。但大革命最终失败了，从中可以吸取的经验教训是（ ）。","options":{"A":"要取得革命胜利，必须坚持武装斗争，组建由党直接统帅和指挥的军队","B":"党必须加强自身建设，加强党的民主集中制","C":"要争取无产阶级在革命中的领导权","D":"要始终保持自身的独立性，实行“又团结又斗争”的方针"},"answer":"ABCD"},{"num":31,"stem":"1945年,包括台湾同胞在内的全体中华儿女前仆后继、浴血奋战,取得中国人民抗日战争暨世界反法西斯战争的伟大胜利,台湾随之光复,重回祖国怀抱。台湾光复是（ ）。","options":{"A":"台湾作为中国一部分的历史事实和法理链条的重要一环","B":"中国政府恢复对台湾行使主权的重要铁证","C":"中国人民抗日战争胜利的重要成果","D":"两岸同胞的共同荣光和全体中华儿女的民族记忆"},"answer":"ABCD"},{"num":32,"stem":"对于新中国的工业化，有人认为：毛泽东他们那一代人是打地基、搭框架的，提供了一套毛坯房；而邓小平们则为这座房子进行了基础装修；现如今我们所做的，该是在前两步的基础上，对房子进行精装修了。依据材料所述，下列有关新中国社会主义建设基本历程叙述正确的是（ ）","options":{"A":"1957年底，中国初步建立了社会主义工业化的基础","B":"1995年，社会主义市场经济体制在中国初步形成","C":"1978年，城市经济体制改革全面展开","D":"1992年，明确提出建立社会主义市场经济体制的目标"},"answer":"AD"},{"num":33,"stem":"1978 年，《光明日报》发表了《实践是检验真理的唯一标准》一文，重申了实践是检验真理的唯一标准这个马克思主义认识论的基本原理，从根本理论上否定了“两个凡是”的错误方针，引起了全国范围内的广泛注意和讨论。这场讨论（ ）","options":{"A":"重新确立了实事求是的思想路线","B":"是一场马克思主义思想解放运动","C":"明确地解决了党的思想路线问题","D":"成为拨乱反正和改革开放的思想先导"},"answer":"BCD"},{"num":34,"stem":"抗日战争胜利后,蒋介石集团的既定方针是以武力消灭共产党及其领导的人民军队和解放区政权。但是,1945年8月,蒋介石还是连发三电,邀请毛泽东赴重庆谈判。这是因为（ ）。","options":{"A":"国民党统治区陷入严重经济危机,无法筹措内战经费","B":"国际上苏联、美国等都表示希望中国能够实行和平建国","C":"全国人民强烈要求和平、反对内战","D":"国民党军队需要相当的时间才能运往内战前线、完成内战部署"},"answer":"BCD"},{"num":35,"stem":"1978年 12月,党召开十一届三中全会,实现了新中国成立以来党的历史上具有深远意义的伟大转折。党的十一届三中全会（ ）。","options":{"A":"作出把党和国家工作中心转移到经济建设上来、实行改革开放的历史性决策","B":"重新确立解放思想、实事求是的思想路线","C":"成为正本清源、拨乱反正和改革开放的思想先导","D":"停止使用“以阶级斗争为纲”的错误提法"},"answer":"ABD"},{"num":36,"stem":"纪录片《走近毛泽东》中有这样一个情节：在西柏坡的院子里，警卫员给毛泽东梳头时拔下一根白发，毛泽东打趣地说：“打了三个胜仗，白了一根头发，值得！”这“三个胜仗”是指（ ）","options":{"A":"辽沈战役","B":"淮海战役","C":"平津战役","D":"百团大战"},"answer":"ABC"},{"num":37,"stem":"解决农民的土地问题，实现“耕者有其田”，是中国民主革命的根本问题，也是中国共产党在民主革命时期的基本任务。在党的土地政策中，包含“耕者有其田”思想的有（ ）。","options":{"A":"《关于清算、减租及土地问题的指示》","B":"《中国土地法大纲》","C":"《井冈山土地法》","D":"《关于抗日根据地土地政策的决定》"},"answer":"ABC"},{"num":38,"stem":"从 1952年到 1978年,我国工农业总产值平均年增长率为8.2%,其中工业年均增长 11.4%。\n按照不变价格计算,1952年国内生产总值为 679 亿元人民币,1976 年增加到 2965 亿元。人均国内生产总值从 1952 年的119 元增加到1976年的319 元。经过20 多年坚持不懈的努力，我国建立起独立的、比较完整的工业体系和国民经济体系。独立的、比较完整的工业体系和国民经济体系的建立（ ）。","options":{"A":"为中国以后的发展奠定了牢固的物质技术基础","B":"为中国在平等互利的原则下发展对外贸易和经济往来创建了前提","C":"从根本上解决了工业化中“从无到有”的问题","D":"使中国在赢得政治上的独立后赢得了经济上的独立"},"answer":"ABCD"},{"num":39,"stem":"解放战争中国共产党能够迅速取胜的原因有（ ）。","options":{"A":"人民群众的支持","B":"中国共产党的坚强领导","C":"国民党军队的腐败涣散","D":"解放军的英勇善战"},"answer":"ABCD"},{"num":40,"stem":"华北事变后,中日民族矛盾进一步激化。在中国共产党救亡图存、全民抗战的号召和地下党组织领导下,1935年12月9日,北平学生举行声势浩大的抗日游行,喊出“反对华北自治”\n“打倒日本帝国主义”“停止内战,一致对外”等口号,遭到国民党军警镇压。由此开始的一\n二·九运动迅速波及全国。一二·九运动（ ）。","options":{"A":"为抗日战争和中国革命事业准备了一大批骨干力量","B":"标志着中国人民抗日救亡运动新高潮的到来","C":"极大地促进了中华民族觉醒","D":"成为时局转换的枢纽,直接促成了抗日民族统一战线的正式建立"},"answer":"ABC"},{"num":41,"stem":"抗美援朝战争的伟大胜利,是中国人民站起来后吃立于世界东方的宣言书,是中华民族走向伟大复兴的重要里程碑。志愿军将士面对强大而凶狠的作战对手,身处恶劣而残酷的战场\n环境,抛头颅、洒热血,以“钢少气多”力克“钢多气少”。经此一战,中国人民真正扬眉吐气\n极大促进了国防和军队现代化,有力推动了世界和平与人类进步事业。这一战,拼来了山河\n无恙、家国安宁,人民军队战斗力威震世界,让全世界对中国刮目相看,充分展示了中国人民（ ）。","options":{"A":"万众一心的顽强品格","B":"维护世界和平的坚定决心","C":"不畏强暴的钢铁意志","D":"敢打必胜的血性铁骨"},"answer":"ABCD"},{"num":42,"stem":"1935年1月,中央政治局在长征途中举行遵义会议,这在党的历史上是一个生死攸关的转折点。遵义会议（ ）。","options":{"A":"开启了党独立自主解决中国革命实际问题的新阶段","B":"确立党中央的正确领导,创造性地制定和实施符合中国革命特点的战略策略","C":"标志着中国共产党在政治上开始走向成熟","D":"使实事求是的思想路线在全党范围确立起来"},"answer":"ABC"},{"num":43,"stem":"1992 年1 月18 日至2 月21 日，邓小平先后视察武昌、深圳、珠海、上海等地，并发表重要谈话。此次谈话的主要内容有（ ）","options":{"A":"关于社会主义初级阶段的长期性和前途","B":"阐明了社会主义本质","C":"计划和市场都是经济手段","D":"提出了“三步走”战略"},"answer":"ABC"},{"num":44,"stem":"《关于党的百年奋斗重大成就和历史经验的决议》系统全面地概括了党的百年奋斗所积累的具有根本性和长远指导意义的十条历史经验。这十条历史经验是系统完整、相互贯通的有机整体，揭示了（ ）。","options":{"A":"党永葆先进性和纯洁性、始终走在时代前列的根本途径","B":"党始终掌握历史主动的根本原因","C":"党始终立于不败之地的力量源泉","D":"党和人民事业不断成功的根本保证"},"answer":"ABCD"},{"num":45,"stem":"新时代中国特色社会主义思想的重大意义体现在（ ）。","options":{"A":"它是中国特色社会主义理论体系的重要组成部分","B":"它是党和人民实践经验和集体智慧的结晶","C":"它是全党全国人民为实现中华民族伟大复兴而奋斗的行动指南","D":"它是马克思主义中国化最新成果"},"answer":"ABCD"}]};

  const LS_KEY = "quiz_autograde_v1_" + (DATA.meta?.title || "quiz");

  function esc(s) {
    return String(s ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  }

  function el(tag, attrs = {}, children = []) {
    const e = document.createElement(tag);
    for (const [k,v] of Object.entries(attrs)) {
      if (k === "class") e.className = v;
      else if (k === "html") e.innerHTML = v;
      else e.setAttribute(k, v);
    }
    for (const c of children) {
      if (c == null) continue;
      if (typeof c === "string") e.appendChild(document.createTextNode(c));
      else e.appendChild(c);
    }
    return e;
  }

  const LETTER_ORDER = ["A","B","C","D","E","F"];
  function lettersFor(q) {
    const keys = (q && q.options) ? Object.keys(q.options) : [];
    const picked = LETTER_ORDER.filter(k => keys.includes(k));
    return picked.length ? picked : ["A","B","C","D"];
  }


  function loadState() {
    try {
      return JSON.parse(localStorage.getItem(LS_KEY) || "{}");
    } catch {
      return {};
    }
  }
  function saveState(state) {
    localStorage.setItem(LS_KEY, JSON.stringify(state));
    setStatus("已自动保存", false);
  }

  function setStatus(msg, sticky) {
    const bar = document.getElementById("statusBar");
    if (!bar) return;
    const t = new Date();
    const hh = String(t.getHours()).padStart(2,"0");
    const mm = String(t.getMinutes()).padStart(2,"0");
    bar.innerHTML = `<b>${esc(msg)}</b> <span class="status">（${hh}:${mm}）</span>`;
    if (!sticky) {
      if (setStatus._tm) clearTimeout(setStatus._tm);
      setStatus._tm = setTimeout(() => {
        bar.innerHTML = bar.innerHTML.replace(/<b>.*?<\/b>/, "<b>未判分</b>");
      }, 1500);
    }
  }

  function applyChoiceVisual(qid) {
    const box = document.getElementById(`q-${qid}`);
    if (!box) return;
    box.classList.remove("correct","wrong","unanswered");
    const tag = document.getElementById(`tag-${qid}`);
    if (tag) {
      tag.className = "tag warn";
      tag.textContent = "未判分";
    }
    box.querySelectorAll(".opt").forEach(o => o.classList.remove("correct","wrong"));
  }

  function render() {
    const state = loadState();
    const singleList = document.getElementById("singleList");
    const multiList = document.getElementById("multiList");
    if (singleList) singleList.innerHTML = "";
    if (multiList) multiList.innerHTML = "";

    // 单选题
    for (const q of DATA.single) {
      const qid = `S${q.num}`;
      const chosen = state[qid] ?? "";
      const qBox = el("div", {class:"q", id:`q-${qid}`});
      const head = el("div", {class:"q-head"}, [
        el("div", {class:"q-title"}, [`单选 ${q.num}`]),
        el("div", {class:"q-meta"}, [
          el("span", {class:"tag"}, ["1分"]),
          el("span", {class:"tag warn", id:`tag-${qid}`}, ["未判分"]),
        ])
      ]);

      const stem = el("div", {class:"stem", html: esc(q.stem)});

      const opts = el("div", {class:"options"});
      for (const letter of lettersFor(q)) {
        const name = `ans-${qid}`;
        const optId = `${qid}-${letter}`;
        const opt = el("label", {class:"opt", for:optId});
        const radio = el("input", {
          type: "radio",
          name,
          id: optId,
          value: letter
        });
        radio.checked = (chosen === letter);
        radio.addEventListener("change", () => {
          const st = loadState();
          st[qid] = letter;
          delete st._grade;
          saveState(st);
          applyChoiceVisual(qid);
          refreshTopStats();
        });
        opt.appendChild(radio);
        opt.appendChild(el("div", {class:"letter"}, [letter]));
        opt.appendChild(el("div", {class:"text"}, [q.options?.[letter] ?? ""]));
        opts.appendChild(opt);
      }

      const ansLine = el("div", {class:"answer-line", id:`ans-${qid}`});
      ansLine.innerHTML = `参考答案：<b>${esc(q.answer)}</b>`;

      qBox.appendChild(head);
      qBox.appendChild(stem);
      qBox.appendChild(opts);
      qBox.appendChild(ansLine);

      if (singleList) singleList.appendChild(qBox);
    }

    // 多选题
    for (const q of DATA.multi) {
      const qid = `M${q.num}`;
      const chosenArr = Array.isArray(state[qid]) ? state[qid] : [];
      const chosenSet = new Set(chosenArr);
      const qBox = el("div", {class:"q", id:`q-${qid}`});
      const head = el("div", {class:"q-head"}, [
        el("div", {class:"q-title"}, [`多选 ${q.num}`]),
        el("div", {class:"q-meta"}, [
          el("span", {class:"tag"}, ["1分"]),
          el("span", {class:"tag warn", id:`tag-${qid}`}, ["未判分"]),
        ])
      ]);

      const stem = el("div", {class:"stem", html: esc(q.stem)});

      const opts = el("div", {class:"options"});
      for (const letter of lettersFor(q)) {
        const optId = `${qid}-${letter}`;
        const opt = el("label", {class:"opt", for:optId});
        const cb = el("input", {
          type: "checkbox",
          id: optId,
          value: letter
        });
        cb.checked = chosenSet.has(letter);
        cb.addEventListener("change", () => {
          const st = loadState();
          const box = document.getElementById(`q-${qid}`);
          const picked = box
            ? Array.from(box.querySelectorAll('input[type=checkbox]:checked')).map(x => x.value)
            : [];
          st[qid] = picked;
          delete st._grade;
          saveState(st);
          applyChoiceVisual(qid);
          refreshTopStats();
        });
        opt.appendChild(cb);
        opt.appendChild(el("div", {class:"letter"}, [letter]));
        opt.appendChild(el("div", {class:"text"}, [q.options?.[letter] ?? ""]));
        opts.appendChild(opt);
      }

      const ansLine = el("div", {class:"answer-line", id:`ans-${qid}`});
      ansLine.innerHTML = `参考答案：<b>${esc(q.answer)}</b>`;

      qBox.appendChild(head);
      qBox.appendChild(stem);
      qBox.appendChild(opts);
      qBox.appendChild(ansLine);

      if (multiList) multiList.appendChild(qBox);
    }

    // 恢复：显示答案
    applyAnswerVisibility(!!state._showAnswers);

    // 恢复：判分标记
    if (state._grade) applyGrade(state._grade, false);

    refreshTopStats();
  }

  function gradeNow() {
    const st = loadState();
    let total = 0, got = 0;
    let singleTotal = 0, singleGot = 0;
    let multiTotal = 0, multiGot = 0;
    const per = {};

    // 单选
    for (const q of DATA.single) {
      const qid = `S${q.num}`;
      singleTotal++; total++;
      const chosen = st[qid] ?? "";
      const correct = q.answer;
      const status = chosen ? (chosen === correct ? "correct" : "wrong") : "unanswered";
      if (status === "correct") { singleGot++; got++; }
      per[qid] = { chosen, correct, status, kind:"single" };
    }

    // 多选（全对计 1 分，否则 0 分）
    for (const q of DATA.multi) {
      const qid = `M${q.num}`;
      multiTotal++; total++;
      const chosenArr = Array.isArray(st[qid]) ? st[qid] : [];
      const chosen = Array.from(new Set(chosenArr)).sort().join("");
      const correct = q.answer.split("").sort().join("");
      const status = chosen ? (chosen === correct ? "correct" : "wrong") : "unanswered";
      if (status === "correct") { multiGot++; got++; }
      per[qid] = { chosen, correct, status, kind:"multi" };
    }

    const grade = {
      total, got,
      singleTotal, singleGot,
      multiTotal, multiGot,
      per
    };

    st._grade = grade;
    saveState(st);
    applyGrade(grade, true);
    refreshTopStats();
  }

  function applyGrade(grade, showToast) {
    for (const [qid, info] of Object.entries(grade.per || {})) {
      const box = document.getElementById(`q-${qid}`);
      if (!box) continue;
      box.classList.remove("correct","wrong","unanswered");
      box.classList.add(info.status);

      const tag = document.getElementById(`tag-${qid}`);
      if (tag) {
        if (info.status === "correct") {
          tag.className = "tag ok";
          tag.textContent = "正确";
        } else if (info.status === "wrong") {
          tag.className = "tag bad";
          tag.textContent = "错误";
        } else {
          tag.className = "tag warn";
          tag.textContent = "未答";
        }
      }

      const correctSet = new Set(String(info.correct ?? "").split(""));
      const chosenSet = new Set(String(info.chosen ?? "").split(""));

      box.querySelectorAll(".opt").forEach(opt => {
        opt.classList.remove("correct","wrong");
        const inp = opt.querySelector("input");
        if (!inp) return;
        const v = inp.value;
        if (correctSet.has(v)) opt.classList.add("correct");
        if (chosenSet.has(v) && !correctSet.has(v)) opt.classList.add("wrong");
      });
    }

    const msg = `总分 ${grade.total}，得分 ${grade.got}（单选 ${grade.singleGot}/${grade.singleTotal}，多选 ${grade.multiGot}/${grade.multiTotal}）`;
    const bar = document.getElementById("statusBar");
    if (bar) bar.innerHTML = `<b>${esc(msg)}</b>`;
    if (showToast) setStatus(msg, true);
  }

  function refreshTopStats() {
    const st = loadState();
    const g = st._grade;

    const singleAnswered = DATA.single.filter(q => (st[`S${q.num}`] ?? "") !== "").length;
    const multiAnswered = DATA.multi.filter(q => Array.isArray(st[`M${q.num}`]) && st[`M${q.num}`].length > 0).length;
    const totalAnswered = singleAnswered + multiAnswered;
    const total = DATA.single.length + DATA.multi.length;

    const top = document.getElementById("statsTop");
    if (!top) return;
    const score = g ? `得分 <strong>${g.got}</strong>/${g.total}` : "未判分";
    top.innerHTML = `
      <span class="pill">进度 <strong>${totalAnswered}</strong>/${total}</span>
      <span class="pill">单选 <strong>${singleAnswered}</strong>/${DATA.single.length}</span>
      <span class="pill">多选 <strong>${multiAnswered}</strong>/${DATA.multi.length}</span>
      <span class="pill">${score}</span>
    `;
  }

  function applyAnswerVisibility(show) {
    document.querySelectorAll(".answer-line").forEach(e => {
      e.classList.toggle("show", show);
    });
    const btn = document.getElementById("btnToggleAnswers");
    if (btn) btn.textContent = show ? "隐藏答案" : "显示答案";
  }

  function clearChoices() {
    const st = loadState();
    for (const q of DATA.single) delete st[`S${q.num}`];
    for (const q of DATA.multi) delete st[`M${q.num}`];
    delete st._grade;
    saveState(st);
    render();
  }

  function resetAll() {
    localStorage.removeItem(LS_KEY);
    render();
    setStatus("已清空本页所有保存", true);
  }

  function scrollToQ(qid) {
    const elQ = document.getElementById(`q-${qid}`);
    if (elQ) elQ.scrollIntoView({behavior:"smooth", block:"start"});
  }

  function filterShow(mode) {
    const st = loadState();
    const g = st._grade;
    const all = document.querySelectorAll(".q");
    all.forEach(x => x.style.display = "");
    if (!mode) return;

    if (mode === "unanswered") {
      all.forEach(box => {
        const id = box.id.replace(/^q-/, "");
        const val = st[id];
        const answered = Array.isArray(val) ? val.length > 0 : !!val;
        if (answered) box.style.display = "none";
      });
      return;
    }

    if (mode === "wrong") {
      if (!g) {
        setStatus("请先提交判分后再筛选", true);
        return;
      }
      all.forEach(box => {
        const id = box.id.replace(/^q-/, "");
        const info = g.per?.[id];
        if (!info || info.status !== "wrong") box.style.display = "none";
      });
    }
  }

  // Wire up buttons
  document.getElementById("btnGrade")?.addEventListener("click", gradeNow);
  document.getElementById("btnClear")?.addEventListener("click", clearChoices);
  document.getElementById("btnReset")?.addEventListener("click", resetAll);
  document.getElementById("btnFilterUnanswered")?.addEventListener("click", () => filterShow("unanswered"));
  document.getElementById("btnFilterWrong")?.addEventListener("click", () => filterShow("wrong"));
  document.getElementById("btnShowAll")?.addEventListener("click", () => filterShow(null));

  document.getElementById("btnToggleAnswers")?.addEventListener("click", () => {
    const st = loadState();
    const next = !st._showAnswers;
    st._showAnswers = next;
    saveState(st);
    applyAnswerVisibility(next);
  });

  document.getElementById("jumpInput")?.addEventListener("keydown", (e) => {
    if (e.key !== "Enter") return;
    const v = e.target.value.trim();
    if (!v) return;

    const mMulti = v.match(/^m(\d+)$/i);
    if (mMulti) {
      scrollToQ(`M${parseInt(mMulti[1],10)}`);
      return;
    }

    const mNum = v.match(/^(\d+)$/);
    if (mNum) {
      scrollToQ(`S${parseInt(mNum[1],10)}`);
      return;
    }
  });

  // Init
  render();
</script>
</body>
</html>
